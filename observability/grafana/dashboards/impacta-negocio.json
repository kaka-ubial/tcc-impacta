{
  "uid": "impacta-negocio",
  "title": "Impacta — Negócio",
  "description": "Métricas de produto: ciclo de vida de doações e transferências, funil de cadastro e saúde da fila.",
  "tags": [
    "impacta",
    "negocio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Doações criadas (24h)",
      "description": "Entradas no status 'pendente'. Usa increase() em vez do valor absoluto porque o contador zera a cada reinício do container no Render — o increase() detecta o reset e não perde a contagem.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(impacta_doacoes_total{env=~\"$env\", status=\"pendente\"}[24h]))",
          "legendFormat": "criadas"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Doações entregues (24h)",
      "description": "Entradas no status 'entregue' — o desfecho que o produto quer maximizar.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(impacta_doacoes_total{env=~\"$env\", status=\"entregue\"}[24h]))",
          "legendFormat": "entregues"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxa de recusa (24h)",
      "description": "Doações recusadas sobre doações criadas. Uma alta aqui é sinal de problema de produto, não de infraestrutura — e é o tipo de achado que rende um ciclo de melhoria documentado.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(impacta_doacoes_total{env=~\"$env\", status=\"recusada\"}[24h])) / sum(increase(impacta_doacoes_total{env=~\"$env\", status=\"pendente\"}[24h]))",
          "legendFormat": "recusa"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs falhados (24h)",
      "description": "Jobs que esgotaram as tentativas. Qualquer valor acima de zero merece olhar os logs no painel do Render.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(impacta_jobs_falhados_total{env=~\"$env\"}[24h]))",
          "legendFormat": "falhas"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Doações por status",
      "description": "Entradas em cada status do ciclo de vida. Atenção: 'cancelado' é masculino em doações e 'cancelada' feminino em transferências — grafia histórica das colunas, proposital.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(impacta_doacoes_total{env=~\"$env\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transferências por status",
      "description": "Mesmo recorte, para o fluxo de excedente entre instituições.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(impacta_transferencias_total{env=~\"$env\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Funil de cadastro",
      "description": "As três etapas do registro, na ordem. Um degrau grande entre etapas aponta onde o usuário desiste.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-impacta"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(impacta_http_requests_total{env=~\"$env\", route=\"register\", method=\"GET\"}[1h]))",
          "legendFormat": "1. abriu o formulário"
        },
        {
          "refId": "B",
          "expr": "sum(increase(impacta_http_requests_total{env=~\"$env\", route=\"validate/register-step-one\"}[1h]))",
          "legendFormat": "2. validou a etapa 1"
        },
        {
          "refId": "C",
          "expr": "sum(increase(impacta_http_requests_total{env=~\"$env\", route=\"register\", method=\"POST\"}[1h]))",
          "legendFormat": "3. concluiu o cadastro"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-impacta"
        },
        "query": {
          "query": "label_values(up{app=\"impacta\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{app=\"impacta\"}, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "dev"
          ],
          "value": [
            "dev"
          ]
        },
        "sort": 1
      }
    ]
  }
}
